# ──────────────────────────────────────────────────────────────────────────
# Copy to .env for local development. On Vercel, set these in
# Project Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────────────

# Web Push (required for notifications)
# Generate a key pair with: npx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. "mailto:you@example.com"
VAPID_SUBJECT=

# Google Analytics 4 (optional — page-view and feature tracking)
# Measurement ID of your GA4 web data stream, e.g. "G-XXXXXXXXXX".
# Leave empty to disable analytics entirely.
PUBLIC_GA_MEASUREMENT_ID=

# ENTSO-E Transparency Platform (optional — third price-source fallback)
# Request a free API key at https://transparency.entsoe.eu/
ENTSOE_API_KEY=

# Protects /api/cron/* endpoints. Vercel automatically sends this as an
# "Authorization: Bearer <secret>" header when invoking cron jobs.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Vercel KV / Upstash Redis (auto-injected on Vercel when the KV store is
# linked to the project — only set these locally if you want to test
# against a real store; otherwise an in-memory fallback is used).
KV_REST_API_URL=
KV_REST_API_TOKEN=
